# Copy this file to .env, replace placeholders, and keep the real .env private.
#
# Local start:
#   set -a && source s3tables_delta_pilot/.env && set +a
#   .venv/bin/uvicorn s3tables_delta_pilot.webapp:app --host 127.0.0.1 --port 8090
#
# AWS authentication is intentionally not configured here. Use the normal AWS
# credential chain locally, or an IAM role/service account in ECS or EKS.

# -----------------------------------------------------------------------------
# Temporary team-test login (required)
# -----------------------------------------------------------------------------
# Shared password entered by a user at /login. Choose a strong, unique value.
PILOT_LOGIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_SHARED_PASSWORD

# Server-only cookie-signing secret. At least 32 characters; never disclose it
# to users. Every running service replica must use exactly the same value.
PILOT_LOGIN_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# true behind HTTPS/TLS (ECS/EKS/proxy); false only for local HTTP development.
PILOT_LOGIN_COOKIE_SECURE=false

# -----------------------------------------------------------------------------
# Service behavior and troubleshooting
# -----------------------------------------------------------------------------
AWS_REGION=ap-southeast-1
PILOT_LOG_LEVEL=INFO
# Optional local JSON log file. Leave blank to log to stdout only.
PILOT_LOG_FILE=
# Optional private local session directory. Leave blank to use the OS temp dir.
PILOT_UPLOAD_SESSION_ROOT=

# Bound local transformation work and Glue job concurrency.
PILOT_LOCAL_PROCESSING_CONCURRENCY=2
PILOT_GLUE_MAX_CONCURRENT_RUNS=5

# -----------------------------------------------------------------------------
# Pilot identity emulation (temporary testing only)
# -----------------------------------------------------------------------------
# Default identity used when the browser does not send X-Pilot-User-Id.
PILOT_LOCAL_USER_ID=local-admin

# Optional JSON mapping of caller IDs to authorisation scopes. Keep this empty
# to use the built-in local-admin/local-editor/local-unassigned test profiles.
# Example:
# PILOT_USER_ACCESS_JSON={"analyst":{"is_admin":false,"buckets":[{"table_bucket_arn":"arn:aws:s3tables:ap-southeast-1:123456789012:bucket/example","namespace":"pilot"}]}}
PILOT_USER_ACCESS_JSON=

# -----------------------------------------------------------------------------
# Required for production-grade key-impact acknowledgements
# -----------------------------------------------------------------------------
# A stable, server-only value used to sign key-impact analysis acknowledgements.
# Set a strong secret before team testing; use the same value on every replica.
PILOT_KEY_ANALYSIS_SECRET=REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET

# -----------------------------------------------------------------------------
# Optional skill-bundle upload destination
# -----------------------------------------------------------------------------
PILOT_SKILL_BUNDLE_BUCKET=agentcore-harness-dev
PILOT_SKILL_BUNDLE_PREFIX=skills
