# Build dependencies outside the runtime image. The final Azure Linux image has
# no shell, package manager, pip, or build tooling.
FROM python:3.12-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY s3tables_uploader/requirements.worker.txt ./requirements.txt
RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir --target /app/dependencies -r requirements.txt

COPY s3tables_uploader ./s3tables_uploader


FROM mcr.microsoft.com/azurelinux/distroless/python:3.12

WORKDIR /app

COPY --from=builder /app/dependencies /app/dependencies
COPY --from=builder /app/s3tables_uploader /app/s3tables_uploader

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/dependencies:/app

USER 65532

# Distroless images have no shell; keep the command in exec form.
CMD ["python3", "-m", "s3tables_uploader.worker"]
