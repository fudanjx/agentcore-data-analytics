# -----------------------------------------------------------------------------
# S3 Tables Uploader — runtime configuration
#
# Docker/Compose loads this via env_file: or --env-file. Fill in values before
# running the API. Requirements per environment are noted alongside each key.
# See s3tables_uploader/docs/2026-09-21-refactor-conventions.md for details.
# -----------------------------------------------------------------------------


# ---- Deployment environment -------------------------------------------------
# One of: LOCAL | DEV | STG | PRD. Drives every feature gate on Settings.
S3_UPLOADER_ENVIRONMENT=LOCAL

# LOCAL only: true keeps the temporary frontend (static + cookie login +
# hardcoded profiles); false switches LOCAL to API-only mode (bearer required).
# Ignored in DEV/STG/PRD.
S3_UPLOADER_SERVE_LOCAL_FRONTEND=true

# DEV: must be true (real HTTPS deployment serves the frontend). Validation
#      refuses false in DEV.
# LOCAL: developer's choice — default true; set false for HTTP local dev.
# STG/PRD: irrelevant — no cookies are issued in hardened modes.
S3_UPLOADER_COOKIE_SECURE=false

# STG/PRD default INFO; LOCAL/DEV default DEBUG. Overrides the level manually.
S3_UPLOADER_LOG_LEVEL=


# ---- AWS core ---------------------------------------------------------------
AWS_REGION=ap-southeast-1


# ---- Landing bucket (raw uploads) -------------------------------------------
# Required in every environment.
S3_UPLOADER_LANDING_BUCKET=s3-uploader-v2-landingbucket-zfuu59kvitxh
S3_UPLOADER_LANDING_PREFIX=s3-uploader
# Days to keep raw uploads before lifecycle-managed purge. 1..30. Default 1.
S3_UPLOADER_RAW_RETENTION_DAYS=1


# ---- SQS queues -------------------------------------------------------------
S3_UPLOADER_BASE_QUEUE_URL=https://sqs.ap-southeast-1.amazonaws.com/964340114883/s3-uploader-base.fifo
S3_UPLOADER_LARGE_QUEUE_URL=https://sqs.ap-southeast-1.amazonaws.com/964340114883/s3-uploader-large.fifo
S3_UPLOADER_MUTATION_QUEUE_URL=https://sqs.ap-southeast-1.amazonaws.com/964340114883/s3-uploader-mutations.fifo


# ---- Glue job ---------------------------------------------------------------
S3_UPLOADER_GLUE_JOB_NAME=s3-uploader-ingest


# ---- Contract store (per-table schema + dedup contract) ---------------------
S3_UPLOADER_CONTRACT_BUCKET=ah-data-analytics
S3_UPLOADER_CONTRACT_PREFIX=temp_s3_update/web_ingest/table_contracts


# ---- Upload history / audit projection --------------------------------------
# LOCAL/DEV: optional — defaults to ah-data-analytics /
# temp_s3_update/web_ingest/upload_history.
# STG/PRD:   REQUIRED. Missing values raise a ConfigurationError on startup.
S3_UPLOADER_HISTORY_BUCKET=
S3_UPLOADER_HISTORY_PREFIX=


# ---- Cookie login (LOCAL/DEV frontend) --------------------------------------
# LOGIN_SECRET must be at least 32 characters (HMAC signing key).
S3_UPLOADER_LOGIN_PASSWORD=test
S3_UPLOADER_LOGIN_SECRET=testtesttesttesttesttesttesttest
# Optional; default 43200 (12 hours).
S3_UPLOADER_SESSION_TTL_SECONDS=


# ---- Bearer auth (all environments) -----------------------------------------
# ARN of the Secrets Manager secret whose SecretString is the bearer token.
# REQUIRED in EVERY environment — bearer auth is now accepted in LOCAL, DEV,
# STG and PRD alike (LOCAL/DEV also accept the cookie flow when the frontend
# surface is served). Startup fails if this is unset.
# See docs/architecture/environment-variables.md and docs/architecture/complete-v3-flow.md.
S3_UPLOADER_BEARER_SECRET_ARN=arn:aws:secretsmanager:ap-southeast-1:964340114883:secret:dev/s3-uploader-key-KmSWEk
# In-memory cache TTL. Default 3600.
S3_UPLOADER_BEARER_CACHE_TTL_SECONDS=
# Damper: at most one forced Secrets Manager fetch per this interval when the
# presented token misses the cache. Default 300.
S3_UPLOADER_BEARER_REFRESH_MIN_INTERVAL_SECONDS=


# ---- Public API base URL (optional, currently unused by the API) ------------
# Retained for future URL-building needs (CORS origin, email links, …).
# Leave blank unless something downstream reads it.
S3_UPLOADER_API_BASE_URL=


# ---- Skill bundle destination -----------------------------------------------
# Where uploaded skill files and versions land in S3.
# LOCAL/DEV: optional — defaults to agentcore-harness-dev / skills.
# STG/PRD:   REQUIRED. Missing values raise a ConfigurationError on startup
#            so production never accidentally writes to the DEV bucket.
S3_UPLOADER_SKILL_BUNDLE_BUCKET=agentcore-harness-dev
S3_UPLOADER_SKILL_BUNDLE_PREFIX=skills


# ---- Uvicorn (start_api.py) -------------------------------------------------
# All optional; defaults: 0.0.0.0 / 8090 / 1.
UVICORN_HOST=
UVICORN_PORT=
UVICORN_WORKERS=
