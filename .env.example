# Shared AWS region fallback
AWS_DEFAULT_REGION=ap-southeast-1

# Optional AgentCore Gateways. Empty, unset, or {} exposes no Gateway tools.
# Shape: {"analytics":{"label":"Analytics","url":"https://gateway-id.gateway.bedrock-agentcore.REGION.amazonaws.com","arn":"arn:aws:bedrock-agentcore:REGION:ACCOUNT_ID:gateway/gateway-id"}}
AGENTCORE_GATEWAYS_JSON={}

# Optional Claude Agent Skills. Empty SKILLS_BUCKET disables skills.
# Empty SKILLS_PREFIX means skill directories are stored at the bucket root.
SKILLS_BUCKET=
SKILLS_PREFIX=
SKILLS_MAX_OBJECT_BYTES=50000000
SKILLS_MAX_SYNC_BYTES=250000000

# Claude Agent SDK
MODEL_ARN=arn:aws:bedrock:us-east-1:964340114883:application-inference-profile/ji5jakx5lho3
CLAUDE_AGENT_MAX_BUFFER_BYTES=10485760

# AgentCore Memory
MEMORY_REGION=ap-southeast-1
MEMORY_ID=memory_runtime_dev-QNTwTS3Onp
MEMORY_MAX_SHORT_TERM_EVENTS=30
MEMORY_MAX_SHORT_TERM_CONTEXT_CHARS=40000

# AgentCore Code Interpreter
CODE_INTERPRETER_REGION=ap-southeast-1
CODE_INTERPRETER_ID=code_interpreter_runtime_dev-PEpoCecsBL
CODE_INTERPRETER_SESSION_TIMEOUT_SECONDS=1800
CODE_INTERPRETER_MAX_RESULT_CHARS=200000

# Dify proxy model-usage persistence (empty disables persistence)
MODEL_USAGE_DATABASE_URL=

# S3 Tables pilot skill builder
SKILL_BUILD_DIFY_URL=https://dify-eks.bot-alex.com/v1/chat-messages
SKILL_BUILD_DIFY_API_KEY=
SKILL_BUILD_DESTINATION_BUCKET=agentcore-harness-dev
SKILL_BUILD_DESTINATION_PREFIX=skills/
SKILL_BUILD_MAX_BYTES=200000
SKILL_BUILD_TIMEOUT_SECONDS=300
